{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    "terminal",
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors"
  ],
  "logo": {
    "type": "auto",
    "source": "arch",
    "color": {
      "1": "yellow",
      "2": "yellow"
    }
  },
  "display": {
    "color": {
      "keys": "yellow",
      "title": "light_red"
    },
    "key": {
      "width": 22,
      "type": "both"
    },
    "bar": {
      "width": 10,
      "char": {
        "elapsed": "■",
	"total": "-"
      }
    },
    "percent": {
      "type": 2
    }
  }
}
