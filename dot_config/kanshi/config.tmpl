{{- if contains "gameboy" .chezmoi.hostname -}}
profile laptop {
    output eDP-1 enable mode 1920x1080@59.98Hz position 0,0 scale 1
    exec hyprctl keyword monitor eDP-1,preferred,auto,1
    exec hyprctl reload
    exec pkill -SIGUSR2 waybar
}

profile docked {
    output eDP-1 disable
    output DP-7 enable mode 1920x1080@60Hz position 1920,0 scale 1
    output DP-5 enable mode 1920x1080@60Hz position 3840,0 scale 1
    exec pkill -SIGUSR2 waybar
}
{{- end }}
